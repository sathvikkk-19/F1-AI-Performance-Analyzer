# ====================================================================
# F1 2026 Simulator - Environment Configuration Template
# Copy this file to '.env' and fill in your private admin credentials.
# The '.env' file is strictly excluded from Git (.gitignore).
# ====================================================================

# Secret key for cryptographic session cookies
F1_SECRET_KEY=change-this-to-a-secure-random-key

# Chief Administrator Username
F1_ADMIN_USERNAME=your_admin_username

# Chief Administrator Master Password
F1_ADMIN_PASSWORD=your_secure_admin_password

# FIA Master Passkey required for administrative portal authorization
F1_ADMIN_PASSKEY=F1-PASSKEY-YOUR-SECRET-PASSKEY-HERE

# Optional SMTP Settings for Live Email OTP Dispatch
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
